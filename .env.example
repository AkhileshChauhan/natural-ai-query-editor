# Copy to .env (git-ignored). docker compose reads .env automatically;
# for the Spring apps, export these in your shell or set them in your IDE run config.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_PORT=5432                 # change to 5433 if something already uses 5432

# --- mcp-sql-server ---
MCP_DB_PASSWORD=mcp_app_dev  # password the server sets for the least-privilege mcp_app role
MCP_API_KEY=change-me        # clients must send this to call the MCP server

# --- sql-client ---
ANTHROPIC_API_KEY=
LLM_MODEL=
MCP_SERVER_URL=http://localhost:8081
PREVIEW_TOKEN_SECRET=change-me-to-a-long-random-string

# --- optional pgAdmin (docker compose --profile tools up -d) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
