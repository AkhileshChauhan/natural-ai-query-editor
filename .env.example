# Copy to .env (git-ignored). docker compose reads .env automatically;
# for the Spring apps, export these in your shell or set them in your IDE run config.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# change to 5433 if something already uses 5432
PG_PORT=5432

# --- mcp-sql-server ---
# password the server sets for the least-privilege mcp_app role
MCP_DB_PASSWORD=mcp_app_dev
# clients must send this to call the MCP server
MCP_API_KEY=change-me

# --- sql-client ---
# sign-in for the web page
APP_USERNAME=admin
APP_PASSWORD=change-me
# from openrouter.ai, not console.anthropic.com
OPENROUTER_API_KEY=
# only for the -Panthropic profile
ANTHROPIC_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
MCP_SERVER_URL=http://localhost:8081
PREVIEW_TOKEN_SECRET=change-me-to-a-long-random-string

# --- optional pgAdmin (docker compose --profile tools up -d) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
